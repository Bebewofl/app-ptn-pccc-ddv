rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "bebewofl@gmail.com";
    }

    function isOfficialPilot() {
      return signedIn() && email() in [
        "dowait17@gmail.com",
        "phanngoctuyen28022003@gmail.com",
        "tuyent0319@gmail.com",
        "nguyenanhtu7121941@gmail.com"
      ];
    }

    function officialRole() {
      return email() == "dowait17@gmail.com" ? "lead3tr" :
             email() == "phanngoctuyen28022003@gmail.com" ? "leadkn" :
             email() == "tuyent0319@gmail.com" ? "leadknnight" :
             email() == "nguyenanhtu7121941@gmail.com" ? "leadatas" :
             "";
    }

    function officialGroups() {
      return email() == "dowait17@gmail.com" ? ["3TR"] :
             email() == "phanngoctuyen28022003@gmail.com" ? ["KN"] :
             email() == "tuyent0319@gmail.com" ? ["KN"] :
             email() == "nguyenanhtu7121941@gmail.com" ? ["ATAS"] :
             [];
    }

    function officialUnits() {
      return isOfficialPilot() ? ["PTN"] : [];
    }

    function units() {
      return isOwner() ? ["PTN","RD","HCNS","KT","KHO","QLCL","BGD"] :
             (isOfficialPilot() ? officialUnits() :
              (accessExists() && access().unitCodes is list ? access().unitCodes : []));
    }

    function permissions() {
      return isOwner() ? ["*"] :
             (accessExists() && access().permissions is list ? access().permissions : []);
    }

    function hasPermission(p) {
      return isOwner() || "*" in permissions() || p in permissions();
    }

    function hasUnit(u) {
      return isOwner() || u in units();
    }

    function accessExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/hub_access/$(email()));
    }

    function access() {
      return get(/databases/$(database)/documents/hub_access/$(email())).data;
    }

    function activeMember() {
      return isOwner() || isOfficialPilot() || (accessExists() && access().active == true);
    }

    function role() {
      return isOwner() ? "head" : (isOfficialPilot() ? officialRole() : access().role);
    }

    function groups() {
      return isOwner() ? ["3TR","KN","ATAS"] : (isOfficialPilot() ? officialGroups() : access().groups);
    }

    function isHead() {
      return isOwner() || role() == "head";
    }

    function isLead() {
      return role() in ["lead3tr","leadkn","leadknnight","leadatas"];
    }

    function ptnRosterGroup(targetEmail) {
      return targetEmail == "bebewofl@gmail.com" ? "MANAGEMENT" :
             targetEmail == "dowait17@gmail.com" ? "3TR" :
             targetEmail == "vuong06042004@gmail.com" ? "3TR" :
             targetEmail == "maicongtuan829@gmail.com" ? "3TR" :
             targetEmail == "tuyent0319@gmail.com" ? "KN" :
             targetEmail == "phanngoctuyen28022003@gmail.com" ? "KN" :
             targetEmail == "binhduong04.dev@gmail.com" ? "KN" :
             targetEmail == "phamduyhien2701206@gmail.com" ? "KN" :
             targetEmail == "vivanthai230604@gmail.com" ? "KN" :
             targetEmail == "phamductuan16091956@gmail.com" ? "KN" :
             targetEmail == "nguyenanhtu7121941@gmail.com" ? "ATAS" :
             targetEmail == "tdat52314@gmail.com" ? "ATAS" :
             targetEmail == "anhminhcung@gmail.com" ? "ATAS" :
             "";
    }

    function ptnRosterEmployeeId(targetEmail) {
      return targetEmail == "bebewofl@gmail.com" ? "NS-001" :
             targetEmail == "dowait17@gmail.com" ? "NS-002" :
             targetEmail == "binhduong04.dev@gmail.com" ? "NS-003" :
             targetEmail == "tuyent0319@gmail.com" ? "NS-004" :
             targetEmail == "phanngoctuyen28022003@gmail.com" ? "NS-005" :
             targetEmail == "vuong06042004@gmail.com" ? "NS-007" :
             targetEmail == "tdat52314@gmail.com" ? "NS-008" :
             targetEmail == "phamduyhien2701206@gmail.com" ? "NS-009" :
             targetEmail == "maicongtuan829@gmail.com" ? "NS-010" :
             targetEmail == "vivanthai230604@gmail.com" ? "NS-011" :
             targetEmail == "phamductuan16091956@gmail.com" ? "NS-013" :
             targetEmail == "anhminhcung@gmail.com" ? "NS-014" :
             targetEmail == "nguyenanhtu7121941@gmail.com" ? "NS-016" :
             "";
    }

    function isManagedKtvEmail(targetEmail) {
      return targetEmail in [
        "vuong06042004@gmail.com","maicongtuan829@gmail.com",
        "binhduong04.dev@gmail.com","phamduyhien2701206@gmail.com","vivanthai230604@gmail.com","phamductuan16091956@gmail.com",
        "tdat52314@gmail.com","anhminhcung@gmail.com"
      ];
    }

    function expectedKtvRole(targetEmail) {
      return ptnRosterGroup(targetEmail) == "3TR" ? "ktv3tr" :
             ptnRosterGroup(targetEmail) == "KN" ? "ktvkn" :
             ptnRosterGroup(targetEmail) == "ATAS" ? "ktvatas" : "";
    }

    function leadCanManageEmail(targetEmail) {
      return activeMember() && isLead() && isManagedKtvEmail(targetEmail) && ptnRosterGroup(targetEmail) in groups();
    }

    function validLeadGrantedAccess(targetEmail,d) {
      return leadCanManageEmail(targetEmail) &&
        d.email == targetEmail &&
        d.employeeId == ptnRosterEmployeeId(targetEmail) &&
        d.role == expectedKtvRole(targetEmail) &&
        d.groups == [ptnRosterGroup(targetEmail)] &&
        d.spaces == ["ptn","common"] &&
        d.unitCodes == ["PTN"] &&
        d.permissions == [] &&
        d.active == true &&
        d.department == "PTN" &&
        d.personnelTitle == "KTV" &&
        d.grantedByEmail == email() &&
        d.keys().hasOnly([
          "email","name","employeeId","role","groups","spaces","unitCodes","permissions","active","department","personnelTitle",
          "accessModelVersion","grantedByEmail","grantedByRole","createdAt","updatedAt","updatedByEmail"
        ]);
    }

    function canReportPtnMealFor(targetEmail) {
      return ptnRosterGroup(targetEmail) != "" && (
        isHead() || targetEmail == email() || (isLead() && ptnRosterGroup(targetEmail) in groups())
      );
    }

    function validPtnMeal(reportId,d) {
      return d.unitCode == "PTN" &&
        d.employeeEmail is string && ptnRosterGroup(d.employeeEmail) != "" &&
        d.employeeId == ptnRosterEmployeeId(d.employeeEmail) &&
        reportId == d.date + "_" + d.employeeId &&
        canReportPtnMealFor(d.employeeEmail) &&
        d.userUid == request.auth.uid && d.userEmail == email() &&
        d.choice in ["Có ăn","Không ăn"];
    }

    function validPtnPublicMeal(reportId,d) {
      return validPtnMeal(reportId,d) &&
        d.keys().hasOnly(["date","unitCode","choice","employeeId","employeeName","employeeGroup","employeeEmail","userUid","userEmail","updatedAt"]);
    }

    function deskUnit(d) {
      return d.currentDesk == "R&D" ? "RD" :
             d.currentDesk == "Khối Văn phòng / HCNS" ? "HCNS" :
             d.currentDesk == "Khối Văn phòng / Kế toán" ? "KT" :
             d.currentDesk == "Khối Văn phòng / Lấy mẫu - Kho" ? "KHO" :
             d.currentDesk == "Quản lý chất lượng" ? "QLCL" :
             d.currentDesk == "Ban Giám đốc" ? "BGD" :
             "PTN";
    }

    function canReadCaseData(d) {
      let r = role();
      let u = units();
      return activeMember() && (
        r in ["head","bod","coord","testeng"] ||
        ((r in ["lead3tr","leadkn","leadknnight","leadatas","ktv3tr","ktvkn","ktvatas"]) && d.sourceGroup in groups()) ||
        (r == "rnd" && "RD" in u &&
          (d.currentDesk == "R&D" || hasPermission("rnd.tech.overview"))) ||
        (r in ["office","hr"] &&
          d.currentDesk in ["Khối Văn phòng / HCNS","Khối Văn phòng / Kế toán","Khối Văn phòng / Lấy mẫu - Kho"] &&
          deskUnit(d) in u) ||
        (r == "quality" && d.currentDesk == "Quản lý chất lượng" && "QLCL" in u)
      );
    }

    function canReadPrivateHandling(d) {
      let r = role();
      let u = units();
      return activeMember() && (
        r in ["head","bod","coord","testeng"] ||
        (r == "rnd" && d.currentDesk == "R&D" && "RD" in u) ||
        (r in ["office","hr"] &&
          d.currentDesk in ["Khối Văn phòng / HCNS","Khối Văn phòng / Kế toán","Khối Văn phòng / Lấy mẫu - Kho"] &&
          deskUnit(d) in u) ||
        (r == "quality" && d.currentDesk == "Quản lý chất lượng" && "QLCL" in u)
      );
    }

    function leadEscalation() {
      return isLead() &&
        resource.data.sourceGroup in groups() &&
        request.resource.data.status == "Chờ Trưởng phòng" &&
        request.resource.data.currentDesk == "Trưởng phòng PTN" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status","currentDesk","updatedAt","updatedByEmail"]);
    }

    function receiverAck() {
      let r = role();
      let u = units();
      return (
        (r == "rnd" && resource.data.currentDesk == "R&D" && "RD" in u) ||
        (r in ["office","hr"] &&
          resource.data.currentDesk in ["Khối Văn phòng / HCNS","Khối Văn phòng / Kế toán","Khối Văn phòng / Lấy mẫu - Kho"] &&
          deskUnit(resource.data) in u) ||
        (r == "quality" && resource.data.currentDesk == "Quản lý chất lượng" && "QLCL" in u) ||
        (r == "bod" && resource.data.currentDesk == "Ban Giám đốc")
      ) &&
      request.resource.data.status in ["Đã tiếp nhận","Đang xử lý"] &&
      request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status","updatedAt","updatedByEmail"]);
    }

    match /hub_access/{emailId} {
      allow read: if isOwner() || (signedIn() && emailId == email()) || (isOfficialPilot() && emailId == email()) || leadCanManageEmail(emailId);
      allow create: if isOwner() || validLeadGrantedAccess(emailId,request.resource.data);
      allow update: if isOwner() || (
        leadCanManageEmail(emailId) &&
        resource.data.email == emailId &&
        resource.data.role == expectedKtvRole(emailId) &&
        resource.data.groups == [ptnRosterGroup(emailId)] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active","updatedAt","updatedByEmail"]) &&
        request.resource.data.updatedByEmail == email()
      );
      allow delete: if isOwner();
    }

    match /hub_common_room_requests/{requestId} {
      allow read: if isHead() || (signedIn() && resource.data.targetEmail == email()) || (isLead() && resource.data.groupCode in groups());
      allow create: if activeMember() && isLead() &&
        request.resource.data.targetEmail is string && leadCanManageEmail(request.resource.data.targetEmail) &&
        request.resource.data.employeeId == ptnRosterEmployeeId(request.resource.data.targetEmail) &&
        request.resource.data.groupCode == ptnRosterGroup(request.resource.data.targetEmail) &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.requestedByEmail == email() &&
        request.resource.data.status == "pending" &&
        request.resource.data.keys().hasOnly(["targetEmail","targetName","employeeId","groupCode","requestedByUid","requestedByEmail","requestedByName","requestedByRole","status","createdAt","schemaVersion"]);
      allow update: if isHead() &&
        request.resource.data.status in ["approved","rejected"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","decidedAt","decidedByEmail","decisionNote"]) &&
        request.resource.data.decidedByEmail == email();
      allow delete: if false;
    }

    match /hub_meta/counters {
      allow read: if activeMember();
      allow create: if activeMember() &&
        request.resource.data.caseCounter == 1;
      allow update: if activeMember() &&
        request.resource.data.caseCounter == resource.data.caseCounter + 1 &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["caseCounter","updatedAt"]);
      allow delete: if false;
    }

    match /hub_cases/{caseId} {
      allow read: if canReadCaseData(resource.data);

      allow create: if activeMember() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.reportedByEmail == email() &&
        (
          isHead() ||
          role() in ["bod","coord","testeng"] ||
          (request.resource.data.sourceGroup in groups())
        );

      allow update: if activeMember() && (isHead() || leadEscalation() || receiverAck());
      allow delete: if false;

      match /private_notes/{noteId} {
        allow read: if canReadPrivateHandling(
          get(/databases/$(database)/documents/hub_cases/$(caseId)).data
        ) && (role() in ["head","bod","coord","testeng"] ||
          (resource.data.unitCode == deskUnit(get(/databases/$(database)/documents/hub_cases/$(caseId)).data) && hasUnit(resource.data.unitCode)));

        allow create: if canReadPrivateHandling(
            get(/databases/$(database)/documents/hub_cases/$(caseId)).data
          ) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorEmail == email() &&
          request.resource.data.unitCode == deskUnit(get(/databases/$(database)/documents/hub_cases/$(caseId)).data) &&
          request.resource.data.text is string &&
          request.resource.data.keys().hasOnly(["text","unitCode","authorUid","authorEmail","authorName","authorRole","createdAt"]);

        allow update, delete: if false;
      }
    }

    match /hub_case_events/{eventId} {
      allow read: if activeMember() &&
        canReadCaseData(
          get(/databases/$(database)/documents/hub_cases/$(resource.data.caseId)).data
        );

      allow create: if activeMember() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == email() &&
        canReadCaseData(
          get(/databases/$(database)/documents/hub_cases/$(request.resource.data.caseId)).data
        );

      allow update, delete: if false;
    }

    match /hub_comments/{commentId} {
      allow read: if activeMember() &&
        canReadCaseData(
          get(/databases/$(database)/documents/hub_cases/$(resource.data.caseId)).data
        );
      allow create: if activeMember() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorEmail == email() &&
        canReadCaseData(
          get(/databases/$(database)/documents/hub_cases/$(request.resource.data.caseId)).data
        ) && (request.resource.data.get("type", "") != "department_response" ||
          canRespondToCase(get(/databases/$(database)/documents/hub_cases/$(request.resource.data.caseId)).data));
      allow update, delete: if false;
    }

    function canRespondToCase(d) {
      let r = role();
      let u = units();
      let desk = deskUnit(d);
      return (r == "head" && desk == "PTN" && d.get("sourceUnitCode", "PTN") == "RD") ||
        (r == "rnd" && desk == "RD" && "RD" in u && hasPermission("rnd.response.manage")) ||
        (r in ["office","hr"] && desk in ["HCNS","KT","KHO"] && desk in u) ||
        (r == "quality" && desk == "QLCL" && "QLCL" in u) ||
        (r == "bod" && desk == "BGD");
    }

    function chatMember() {
      return activeMember() && role() in ["head","lead3tr","leadkn","leadknnight","leadatas","rnd","coord","testeng"];
    }

    function rndPair(d) {
      return d.currentDesk == "R&D" || d.get("sourceUnitCode", "") == "RD" ||
        d.get("sourceSpace", "") == "rnd" || d.get("originUnitCode", "") == "RD" ||
        d.get("sourceGroup", "") == "RND" || d.get("lastExternalUnitCode", "") == "RD" || d.get("interdeptPair", "") == "PTN-RD";
    }

    function canChatThread(thread) {
      return thread == "GENERAL" ||
        (canReadCaseData(get(/databases/$(database)/documents/hub_cases/$(thread)).data) &&
         rndPair(get(/databases/$(database)/documents/hub_cases/$(thread)).data));
    }

    match /hub_interdept_chat/{messageId} {
      allow read: if chatMember() && resource.data.spaceKey == "PTN-RD" && canChatThread(resource.data.threadKey);
      allow create: if chatMember() &&
        request.resource.data.spaceKey == "PTN-RD" &&
        request.resource.data.threadKey is string && canChatThread(request.resource.data.threadKey) &&
        request.resource.data.caseId == (request.resource.data.threadKey == "GENERAL" ? "" : request.resource.data.threadKey) &&
        request.resource.data.type == "interdept_chat" &&
        request.resource.data.userUid == request.auth.uid && request.resource.data.userEmail == email() &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 10000 &&
        request.resource.data.keys().hasOnly(["spaceKey","threadKey","caseId","type","message","userUid","userEmail","userName","roleType","createdAt","schemaVersion"]);
      allow update, delete: if false;
    }

    match /hub_pins/{pinId} {
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.userEmail == email();
      allow update: if signedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.userEmail == resource.data.userEmail;
      allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
    }

    match /hub_meal_reports/{reportId} {
      allow read: if activeMember() && (
        isOwner() ||
        role() in ["bod","coord"] ||
        resource.data.userUid == request.auth.uid ||
        (resource.data.unitCode == "PTN" && resource.data.employeeEmail is string && canReportPtnMealFor(resource.data.employeeEmail)) ||
        (role() in ["office","hr"] && resource.data.unitCode is string && hasUnit(resource.data.unitCode))
      );

      allow create: if activeMember() && (
        (request.resource.data.unitCode == "PTN" && validPtnMeal(reportId,request.resource.data)) ||
        (request.resource.data.unitCode != "PTN" &&
          request.resource.data.userUid == request.auth.uid &&
          request.resource.data.userEmail == email() &&
          request.resource.data.unitCode is string &&
          hasUnit(request.resource.data.unitCode) &&
          !exists(/databases/$(database)/documents/hub_meal_department_reports/$(request.resource.data.date + "_" + request.resource.data.unitCode)))
      );

      allow update: if activeMember() && (
        (request.resource.data.unitCode == "PTN" && validPtnMeal(reportId,request.resource.data)) ||
        (request.resource.data.unitCode != "PTN" &&
          resource.data.userUid == request.auth.uid &&
          request.resource.data.userUid == request.auth.uid &&
          request.resource.data.userEmail == email() &&
          request.resource.data.unitCode is string &&
          hasUnit(request.resource.data.unitCode) &&
          !exists(/databases/$(database)/documents/hub_meal_department_reports/$(request.resource.data.date + "_" + request.resource.data.unitCode)))
      );

      allow delete: if false;
    }

    match /hub_meal_public_status/{reportId} {
      allow read: if activeMember();

      allow create, update: if activeMember() && (
        (request.resource.data.unitCode == "PTN" && validPtnPublicMeal(reportId,request.resource.data)) ||
        (request.resource.data.unitCode != "PTN" &&
          request.resource.data.userUid == request.auth.uid &&
          request.resource.data.unitCode is string &&
          hasUnit(request.resource.data.unitCode) &&
          request.resource.data.choice in ["Có ăn","Không ăn"] &&
          request.resource.data.keys().hasOnly(["date","unitCode","choice","userUid","updatedAt"]))
      );

      allow delete: if false;
    }

    match /hub_meal_department_reports/{reportId} {
      allow read: if activeMember();
      allow create: if activeMember() &&
        (hasPermission("meal.unit.manage") || role() in ["head","lead3tr","leadkn","leadknnight","leadatas","coord"]) &&
        request.resource.data.unitCode is string && request.resource.data.unitCode != "PTN" &&
        hasUnit(request.resource.data.unitCode) &&
        reportId == request.resource.data.date + "_" + request.resource.data.unitCode;

      allow update: if activeMember() &&
        (hasPermission("meal.unit.manage") || role() in ["head","lead3tr","leadkn","leadknnight","leadatas","coord"]) &&
        resource.data.unitCode == request.resource.data.unitCode &&
        resource.data.date == request.resource.data.date &&
        request.resource.data.unitCode != "PTN" &&
        hasUnit(request.resource.data.unitCode) &&
        reportId == request.resource.data.date + "_" + request.resource.data.unitCode;
      allow delete: if false;
    }

    match /hub_meal_guest_reports/{reportId} {
      allow read: if activeMember() && (isOwner() || role() in ["head","bod","coord","office","hr"] || resource.data.reportedByUid == request.auth.uid);
      allow create: if activeMember() &&
        request.resource.data.reportedByUid == request.auth.uid &&
        request.resource.data.reportedByEmail == email() &&
        request.resource.data.unitCode is string &&
        hasUnit(request.resource.data.unitCode) &&
        (hasPermission("meal.guest.create") || role() in ["head","lead3tr","leadkn","leadknnight","leadatas","coord","office","hr","quality","bod"]);
      allow update, delete: if false;
    }

    match /hub_quality_handoffs/{handoffId} {
      allow read: if activeMember() &&
        role() in ["head","bod","quality","testeng","coord"];

      allow create: if isHead() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByEmail == email();

      allow update: if activeMember() &&
        role() in ["head","quality"] &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["status","receivedAt","updatedAt","updatedByEmail","qualityNote"]);

      allow delete: if false;
    }

    match /hub_audit_logs/{auditId} {
      allow read: if isHead() || role() == "bod";
      allow create: if activeMember() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == email();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
