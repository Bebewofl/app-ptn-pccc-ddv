{
  "firestore": {
    "rules": "rules/firestore.v3-service.rules"
  },
  "hosting": {
    "public": "dist-lite",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "hubLiteApi",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9097
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8087
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5017
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "host": "127.0.0.1",
      "port": 9197
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5007
    }
  },
  "storage": {
    "rules": "rules/storage.v3-service.rules"
  },
  "functions": {
    "source": "functions-lite",
    "codebase": "hub-lite",
    "runtime": "nodejs22"
  }
}
