{
  "firestore": {
    "rules": "rules/firestore.v3-lite.emulator.rules"
  },
  "hosting": {
    "public": "dist-lite",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9097
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8087
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5017
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
